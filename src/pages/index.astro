---
const projects = [
  {
    title: "Project One",
    year: "2026",
    description: "A short description of the project will go here."
  },
  {
    title: "Project Two",
    year: "2025",
    description: "A short description of the project will go here."
  },
  {
    title: "Project Three",
    year: "2024",
    description: "A short description of the project will go here."
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Ning Weining</title>
  </head>

  <body>
    <main>
      <section class="hero">
        <p class="label">Ning Weining</p>

        <h1>
          Design researcher working across inclusive design,
          human-centred design and emerging technologies.
        </h1>
      </section>

      <section>
        <div class="section-heading">
          <h2>Selected Work</h2>
        </div>

        <div class="projects">
          {projects.map((project) => (
            <article class="project">
              <div class="placeholder"></div>

              <div class="project-info">
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <span>{project.year}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="section-heading">
          <h2>Research Areas</h2>
        </div>

        <div class="research-list">
          <p>Inclusive Design</p>
          <p>Ageing & Participation</p>
          <p>Human-centred Design</p>
          <p>Design Research</p>
          <p>Emerging Technologies</p>
        </div>
      </section>

      <section class="about">
        <div class="section-heading">
          <h2>About</h2>
        </div>

        <p>
          Ning Weining is a design researcher working across research,
          education and design practice.
        </p>

        <p>
          Contact information and further profile details will be added here.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #111;
    background: #fff;
  }

  main {
    width: min(1400px, calc(100% - 48px));
    margin: 0 auto;
  }

  section {
    padding: 80px 0;
    border-bottom: 1px solid #ddd;
  }

  .hero {
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .label {
    font-size: 16px;
  }

  h1 {
    max-width: 1100px;
    margin: 0;
    font-size: clamp(42px, 7vw, 110px);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
  }

  .section-heading {
    margin-bottom: 48px;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 72px 24px;
  }

  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #eee;
  }

  .project-info {
    position: relative;
    padding-top: 16px;
  }

  .project-info h3 {
    margin: 0 0 8px;
    font-size: 28px;
    font-weight: 500;
  }

  .project-info p {
    max-width: 500px;
    margin: 0;
    line-height: 1.5;
  }

  .project-info span {
    position: absolute;
    top: 18px;
    right: 0;
  }

  .research-list p {
    margin: 0;
    padding: 16px 0;
    border-top: 1px solid #ddd;
    font-size: clamp(28px, 4vw, 56px);
  }

  .about > p {
    max-width: 800px;
    font-size: 28px;
    line-height: 1.3;
  }

  @media (max-width: 700px) {
    main {
      width: min(100% - 28px, 1400px);
    }

    section {
      padding: 56px 0;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .project-info span {
      position: static;
      display: block;
      margin-top: 12px;
    }

    .about > p {
      font-size: 22px;
    }
  }
</style>